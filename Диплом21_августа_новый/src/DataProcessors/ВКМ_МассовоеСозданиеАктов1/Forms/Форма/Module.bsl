
&НаКлиенте
Процедура СоздатьРеализацииДоговор(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Период) ТОгда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Период не заполнен!");
		Возврат;
	КонецЕсли;	

ПараметрыВыполнения = Новый Структура;
ЛогЗагрузки = "";

