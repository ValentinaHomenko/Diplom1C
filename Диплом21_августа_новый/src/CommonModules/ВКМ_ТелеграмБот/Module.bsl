
Процедура СозданиеБота() Экспорт
	
	//++ Хоменко В.И. 18.08.2026
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	МАКСИМУМ(ВКМ_ОбновлениеБотаТелеграм.update_id) КАК update_id
	                      |ИЗ
	                      |	РегистрСведений.ВКМ_ОбновлениеБотаТелеграм КАК ВКМ_ОбновлениеБотаТелеграм"); 
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		OffSet = "?offSet=" + Формат(Выборка.update_id,"ЧГ=0");
	Иначе 	
		OffSet = "";
	КонецЕсли;
	
	Ключ = Константы.ВКМ_ТокенТелеграмБот.Получить();
	Сервер = "api.telegram.org";
	Команда = "getUpdates" + OffSet;
	
	Ресурс = "bot" + Ключ + "/" + Команда; 
	
	Соединение = Новый HTTPСоединение(Сервер,443,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	Запрос = Новый HTTPЗапрос(Ресурс); 
	
	Ответ = Соединение.Получить(Запрос);
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	
	ОтветСоотв = ПрочитатьJSON(Чтение, Истина);
	Если Ответ.КодСостояния = 200 тогда
		getUpdatesОбОтв(ОтветСоотв);
	КонецЕсли; 
	
	//-- Хоменко В.И. 18.08.2026
	
КонецПроцедуры 

Процедура getUpdatesОбОтв(ОтветСоотв)
	
	Для Каждого upd Из ОтветСоотв["result"] Цикл
	  update_id = upd["update_id"];
	  message = upd["message"]; 
 
	  Сообщить(message["text"]);
	  
	  Данные = РегистрыСведений.ВКМ_ОбновлениеБотаТелеграм.СоздатьМенеджерЗаписи();
	  Данные.update_id = upd["update_id"];
	  Данные.date = МестноеВремя(Дата('19700101') + message["date"]);
	  Данные.text = message["text"];  
	  Данные.message_ID = message["message_ID"];  
	  Данные.first_name = message["from"]["first_name"];  
	  Данные.id = message["from"]["id"]; 
	  Данные.Записать();

	  
	КонецЦикла;  
	
КонецПроцедуры


