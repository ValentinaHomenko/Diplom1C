Процедура ОбработатьЗапрос(ЗапросПользователя, ok)
	
	Текст = ЗапросПользователя.text;
	
	Если ЗначениеЗаполнено(Текст) Тогда
		ТекстСообщения = Справочники.ВКМ_УведомленияТелеграмБоту.ТекстСообщения;  
	Иначе
		ТекстСообщения = "Неизвестная команда!";
	КонецЕсли;
	
	ОтправитьСообщение(ТекстСообщения, ЗапросПользователя.id,ok);
	
КонецПроцедуры  

 Процедура ОтправитьСообщение(ТекстСообщения, ПолучательID,ok)
	
	Ключ = Константы.ВКМ_ТокенТелеграмБот.Получить();
	Сервер = "api.telegram.org";
	Команда = "sendMessage";
	
	Ресурс = "bot" + Ключ + "/" + Команда + "?chat_id=" + Формат(ПолучательID, "ЧГ=") + "&text" + СокрЛП(ТекстСообщения); 
	
	Соединение = Новый HTTPСоединение(Сервер,443,,,,,Новый ЗащищенноеСоединениеOpenSSL());
	Запрос = Новый HTTPЗапрос(Ресурс); 
	
	Ответ = Соединение.Получить(Запрос);
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку());
	
	ОтветСоотв = ПрочитатьJSON(Чтение, Истина);
	
	ok = ОтветСоотв["ok"];
	 
КонецПроцедуры 


Процедура ВКМ_УведомленияБота() Экспорт
	
	Если ПолнотекстовыйПоиск.ПолучитьРежимПолнотекстовогоПоиска() = РежимПолнотекстовогоПоиска.Разрешить Тогда
		
		Если Не ПолнотекстовыйПоиск.ИндексАктуален() Тогда
			
			ПолнотекстовыйПоиск.ОбновитьИндекс( , Истина);
			
		КонецЕсли;
		
	КонецЕсли; 
	
	ВКМ_ТелеграмБот.СозданиеБота();
	ВКМ_ТелеграмБот.ОбработатьЗапросы();
	
КонецПроцедуры


 


