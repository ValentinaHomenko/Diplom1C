&НаСервере
Процедура ВКМ_ЗаполнитьНаСервереКоманда()
	
	//++ Хоменко В.И. сентябрь 2026  
	
	Договор = Объект.Договор;
	
    Если Договор <> Неопределено Тогда
		Если Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВКМ_АбоненскоеОбслуживание Тогда 
			ДокументОбъект = РеквизитФормыВЗначение("Объект");
			ДокументОбъект.ВКМ_ВыполнитьАвтозаполнение();
			ЗначениеВРеквизитФормы(ДокументОбъект, "Объект"); 
		Иначе	
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ("Не найден договор с видом Абоненское обслуживание");
			Сообщение.Сообщить();
			
			Отказ = Истина;
			Возврат;  
		КонецЕсли; 
	КонецЕсли;	
		
	//++ Хоменко В.И. сентябрь 2026  

КонецПроцедуры 

