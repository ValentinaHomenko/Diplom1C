&НаКлиенте
Процедура ВКМ_Заполнить(Команда)  
	
	//++ Хоменко В.И. август 2026  
	
	ВКМ_ЗаполнитьНаСервереКоманда();
	 
	//-- Хоменко В.И. август 2026  
	
