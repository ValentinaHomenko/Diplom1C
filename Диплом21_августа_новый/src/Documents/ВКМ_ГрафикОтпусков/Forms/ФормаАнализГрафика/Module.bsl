
 &НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка
	)
	Если Параметры.Свойство("АдресДанных") Тогда
		АдресДанных = Параметры.АдресДанных;
	КонецЕсли;     
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)  
	
	ЗаполнитьНаСервере(); 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Если Не ЗначениеЗаполнено(АдресДанных) Тогда
		ОбщегоНазначения.СообщитьПользователю("Нет адреса данных для построения диаграммы.");
		Возврат;
	КонецЕсли;
	
	ТаблицаОтпусков = ПолучитьИзВременногоХранилища(АдресДанных);
	
	Если ТаблицаОтпусков = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю("Данные не найдены в хранилище.");
		Возврат;
	КонецЕсли;
	
	Если ТаблицаОтпусков.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю("Таблица отпусков пустая.");
		Возврат;
	КонецЕсли;
	
	ПостроитьДиаграммуГанта(ТаблицаОтпусков);
	
КонецПроцедуры

&НаСервере
Процедура ПостроитьДиаграммуГанта(ТаблицаОтпусков) 
	
	Диаграмма.Очистить(); 
	
	Серия = Диаграмма.УстановитьСерию("Отпуск");
	Серия.Текст = "Отпуск";
	Серия.Цвет = WebЦвета.СинеФиолетовый;
	
	Для Каждого Строка Из ТаблицаОтпусков Цикл
		
		Точка = Диаграмма.УстановитьТочку(Строка.Сотрудник);
		Точка.Текст = Строка.Сотрудник.Наименование; 
		Значение = Диаграмма.ПолучитьЗначение(Точка, Серия);
		Интервал = Значение.Добавить();
		Интервал.Начало = Строка.ДатаНачала;
		Интервал.Конец = Строка.ДатаОкончания;
		Интервал.Текст = "Отпуск " + Строка.Дней + " дн.";  
		
		Если Строка.Дней > 28 Тогда
			Интервал.Цвет = WebЦвета.Красный;
		КонецЕсли;   
		
	КонецЦикла
	
КонецПроцедуры

